{
  "name": "heikohardt/t3ee-voting-example",
  "type": "typo3-cms-extension",
  "description": "Example extension for using PHPUnit, Behat and Jasmine within TYPO3 context.",
  "authors": [
    {
      "name": "Heiko Hardt",
      "role": "Developer",
      "email": "typo3.heiko@hardt.me"
    }
  ],
  "license": [
    "GPL-3.0"
  ],
  "keywords": [
    "TYPO3 CMS",
    "bdd",
    "behat",
    "jasmine"
  ],
  "version": "0.0.1",
  "require": {
    "php": ">=5.5.0",
    "typo3/cms": ">=7.6.0,<8.0"
  },
  "require-dev": {
		"behat/behat": "^3.7",
		"behat/mink": "^1.9",
		"behat/mink-extension": "^2.3",
		"behat/mink-goutte-driver": "^1.3",
    "behat/mink-selenium2-driver": "^1.3",
		"phpunit/phpunit": "^5.7",
    "heikohardt/behat-typo3-extension": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "HeikoHardt\\T3eeVotingExample\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HeikoHardt\\T3eeVotingExample\\Tests\\": "Tests",
      "TYPO3\\CMS\\Core\\Tests\\": "../../default.instance/typo3/sysext/core/Tests/"
    }
  },
  "replace": {
    "typo3-ter/t3ee-voting-example": "self.version"
  },

  "scripts": {
		"qa": [
			"mkdir -p .reports/checkstyle",
			"mkdir -p Public",
			"@qa:test:bdd"
		],    
		"qa:test:bdd": [
			"behat -c Tests/Acceptance/behat.yaml --format pretty"
		],    
    "post-autoload-dump": [
      "mkdir -p .run/public/typo3conf/ext",
      "[ -L .run.public/typo3conf/ext/t3ee_voting_example ] || ln -snvf $PWD $PWD/.run/public/typo3conf/ext/t3ee_voting_example"
    ]
  },

	"config": {
		"vendor-dir": ".run/vendor",
		"bin-dir": ".run/bin",
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true
		}
	},
	"extra": {
		"typo3/cms": {
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "dev_template",
			"web-dir": ".run/public"
		}
	}
}
